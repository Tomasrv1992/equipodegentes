# =============================================================================
# Equipo de Gentes — Sample de variables de entorno
# =============================================================================
#
# Este archivo documenta TODAS las env vars que el proyecto necesita,
# agrupadas por sitio donde se configuran (Netlify).
#
# NO subas este archivo lleno con secrets reales a git. Es solo plantilla.
#
# Para correr el proyecto necesitás 2 sitios Netlify:
#   1. equipodegentes-cron   → procesa facturas (background functions)
#   2. equipodegentes-admin  → panel de control (frontend Vite + edge functions)
#
# Y los siguientes servicios externos:
#   - Supabase (Postgres + Auth)
#   - Anthropic (LLM para Word/PDFs no-DIAN)
#   - Resend (email transaccional al cliente)
#   - Google Cloud (OAuth Web Application)
#
# =============================================================================

# -----------------------------------------------------------------------------
# Compartido entre AMBOS sitios (mismo valor en cron y admin)
# -----------------------------------------------------------------------------

# Supabase — datos del proyecto en supabase.com
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vault key para cifrar refresh_tokens de Google en client_credentials.
# Generar con: openssl rand -hex 32
# IMPORTANTE: guardalo en un manager de secrets (1Password, etc) — si se pierde
# todos los refresh_tokens en DB quedan inaccesibles y hay que re-onboardear
# a todos los clientes.
CREDENTIALS_VAULT_KEY=64-hex-chars-aqui

# Secret interno para que el cron stub pueda llamar al background fn.
# Generar con: openssl rand -hex 32
FACTURACION_INTERNAL_SECRET=64-hex-chars-aqui

# Google OAuth Web Application (creado en console.cloud.google.com)
# Scopes requeridos:
#   - gmail.modify
#   - drive
#   - spreadsheets
#   - userinfo.email
# En desarrollo: mode = Testing, agregar emails como "Test users"
# En producción: requires Google verification (2-6 semanas)
GOOGLE_OAUTH_WEB_CLIENT_ID=xxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_WEB_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Solo equipodegentes-cron (el que procesa facturas)
# -----------------------------------------------------------------------------

# Resend (email transaccional). Crear cuenta en resend.com y verificar dominio
# antes de poder enviar a emails que no sean el del owner del account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email "From" — el remitente que ven los clientes. Debe estar en un dominio
# verificado en Resend. Formato: "Nombre <email@dominio.com>"
NOTIFY_EMAIL_FROM=Operatto <noreply@tudominio.com>

# Email "To" fallback (solo para modo legacy single-tenant del owner).
# Para clientes multi-tenant se ignora — se usa cred.notify_email.
NOTIFY_EMAIL_TO=tuemail@gmail.com

# Anthropic API key (para extraer datos de Word/PDFs no-DIAN con Claude Haiku).
# Crear cuenta en console.anthropic.com y cargar mínimo $5 USD.
# Costo aproximado: $0.001 por documento → $5 te cubre ~5000 extracciones.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Año mínimo de facturas a procesar. Si no se setea, usa año actual.
# Útil para casos donde querés procesar el año anterior también.
# MIN_INVOICE_YEAR=2026

# === LEGACY (solo si tenés un cron single-tenant viejo conviviendo) ===========
# Si arrancás de cero, dejá estos en blanco — el código detecta y usa el modo
# multi-tenant automáticamente.
# GOOGLE_CLIENT_ID=xxxxxx-Desktop.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_OAUTH_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# INVOICES_SHEET_ID=
# INVOICES_DRIVE_FOLDER_ID=
# INVOICES_SHEET_TAB=Gastos 2026

# -----------------------------------------------------------------------------
# Solo equipodegentes-admin (panel)
# -----------------------------------------------------------------------------

# Email del admin/owner — solo este usuario puede entrar al panel.
# El frontend valida que session.user.email === ADMIN_ALLOWED_EMAIL.
ADMIN_ALLOWED_EMAIL=tuemail@gmail.com

# URL del propio panel admin (para construir el redirect URI de OAuth).
# Ej: https://tudominio-admin.netlify.app
ADMIN_SITE_URL=https://equipodegentes-admin.netlify.app

# URL del sitio del cron (para que el panel pueda disparar background fns).
# Ej: https://tudominio-cron.netlify.app
MAIN_SITE_URL=https://equipodegentes-cron.netlify.app

# Visibles al frontend (Vite los inyecta en el bundle). Mismo valor que arriba.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_ADMIN_ALLOWED_EMAIL=tuemail@gmail.com
