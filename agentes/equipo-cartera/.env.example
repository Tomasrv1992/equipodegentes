# =====================================================================
# .env.example — Equipo Cartera
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA hagas commit del .env real.
# =====================================================================

# === Anthropic (Claude API) ===
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxx

# === Google Sheets ===
# ID del Sheet: lo encuentras en la URL del Google Sheet, entre /d/ y /edit
# Ej: https://docs.google.com/spreadsheets/d/1AbCdEfGhIjK.../edit  →  ID = 1AbCdEfGhIjK...
GOOGLE_SHEETS_ID=

# Ruta al JSON del Service Account (relativa a la carpeta equipo-cartera/)
GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json

# === Operador (datos del negocio) ===
OPERADOR_NOMBRE=Equipo Cartera
OPERADOR_HORARIO_INICIO=8
OPERADOR_HORARIO_FIN=19
OPERADOR_TIMEZONE=America/Bogota

# === Modo de ejecución ===
ENV=development
LOG_LEVEL=INFO
DRY_RUN=true
