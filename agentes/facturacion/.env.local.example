# --- OAuth Google (mismo refresh token cubre Gmail + Drive + Sheets) ---
# Setup: ver agentes/facturacion/README.md sección "Setup OAuth anti-bobos"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Targets (carpeta Drive + Google Sheet de control) ---
INVOICES_DRIVE_FOLDER_ID=
INVOICES_SHEET_ID=
INVOICES_SHEET_TAB=Gastos 2026

# --- Resend (notificación email diaria) ---
# Free tier: 100 emails/día. Crear key en https://resend.com → API Keys
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=Facturación Automática <onboarding@resend.dev>

# --- Solo para deploy en Netlify (NO va en .env.local) ---
# FACTURACION_INTERNAL_SECRET=<32 bytes hex>  # se setea en Netlify env vars
